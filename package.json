{
  "name": "nova-command",
  "version": "1.0.0",
  "private": true,
  "description": "NOVA — Deep Space Mission Command. Full-stack mission control interface.",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "cross-env NEXT_PUBLIC_API_URL=http://localhost:4000 next dev -p 3000",
    "start": "concurrently -n api,web -c green,cyan \"npm:start:api\" \"npm:start:web\"",
    "start:api": "tsx server/index.ts",
    "start:web": "cross-env NEXT_PUBLIC_API_URL=http://localhost:4000 next start -p 3000",
    "build": "cross-env NEXT_PUBLIC_API_URL=http://localhost:4000 next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
